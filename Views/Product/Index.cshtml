@model IEnumerable<qlsanpham.Models.ViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<form asp-action="Index"method="get">
    <input type="text" name="search" value ="@ViewBag.Search"/>
    <button type="submit">Search</button>
    <a asp-action="Index">quay lại</a>
</form>

<form asp-action="Index" method="get" style="margin-bottom: 15px;">

    <input type="hidden" name="search" value="@ViewBag.Search" />

    <label><b>Sắp xếp theo:</b></label>

    <select name="sortOrder"
            class="form-select"
            style="width: 220px; display: inline-block;"
            onchange="this.form.submit()">

        <option value="">-- Chọn sắp xếp --</option>

        <option value="name_asc"
                selected="@(ViewBag.SortOrder == "name_asc")">
            Tên A-Z
        </option>

        <option value="name_desc"
                selected="@(ViewBag.SortOrder == "name_desc")">
            Tên Z-A
        </option>

        <option value="id_asc"
                selected="@(ViewBag.SortOrder == "id_asc")">
            ID tăng dần
        </option>

        <option value="id_desc"
                selected="@(ViewBag.SortOrder == "id_desc")">
            ID giảm dần
        </option>

    </select>

</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
}

     
    </tbody>
</table>

@for (int i = 1; i <= (int)ViewBag.Sotrang; i++)
{
    <a asp-action="Index"
       asp-route-page="@i"
       asp-route-search="@ViewBag.Search"
       asp-route-sortOrder="@ViewBag.SortOrder"
       class="btn @(i == (int)ViewBag.CurrentPage
                               ? "btn-primary" : "btn-outline-primary")">
    @i
</a>
    }